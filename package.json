{
  "name": "little-parcel-crew",
  "private": true,
  "version": "0.19.0-rc.1",
  "description": "Offline delivery adventure and turn-based puzzle game",
  "scripts": {
    "test": "node tools/verify.js",
    "test:campaign": "node tests/full_campaign.js",
    "test:experience": "node tests/experience.js",
    "test:overhaul": "node tests/overhaul.js",
    "test:postal": "node tests/postal.js",
    "test:adventure": "node tests/adventure.js",
    "test:multitouch": "node tests/multitouch.js",
    "test:world": "node tests/world.js",
    "test:world-routes": "node tests/world-routes.js",
    "test:dog-animation": "node tests/dog-animation.js",
    "test:startup": "node tests/startup.js",
    "test:polish": "node tests/polish.js",
    "test:audio": "node tests/audio-lifecycle.js",
    "test:offline": "node tests/offline-storage.js",
    "test:realtime": "node tests/realtime.js",
    "test:migration-012": "node tests/migration-012.js",
    "test:all-stars": "node tests/all-stars.js",
    "test:landscape": "node tests/landscape.js",
    "test:special": "node tests/special-deliveries.js",
    "test:parcel": "node tests/parcel-mechanics.js",
    "test:migration-013": "node tests/migration-013.js",
    "lint": "eslint web/*.js",
    "start": "python3 tools/serve.py --directory web --port 4187",
    "test:presentation": "node tests/presentation.js",
    "build": "python3 tools/build_release.py",
    "test:release": "node tests/release.js",
    "test:classic": "node tests/test.js",
    "preview": "python3 tools/serve.py --directory dist/web --port 4188",
    "test:saves": "node tests/save-store.js",
    "release:check": "python3 tools/release_gate.py",
    "test:android-evidence": "python3 -m unittest discover -s tests -p test_android_evidence.py -v",
    "diagnostics:package": "python3 tools/package_android_diagnostics.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "playwright": "1.58.0"
  }
}
